# ─── Database ──────────────────────────────────────────────────────────────
# PostgreSQL connection string. Tables are created/updated automatically on start.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/content_management

# ─── Super Admin (email + password sign-in) ───────────────────────────────
# Created on first start (an older admin@cf.com / developerquickupp0079 Super Admin
# account is moved to this email and given this password).
# Set SUPER_ADMIN_RESET_PASSWORD=true for one restart to force the password below.
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=your_super_admin_password_here
SUPER_ADMIN_NAME=Super Admin
# SUPER_ADMIN_RESET_PASSWORD=true

# Starting password for team members seeded from server/team.ts (never overwrites a set password)
TEAM_DEFAULT_PASSWORD=your_team_default_password_here

# ─── Server ────────────────────────────────────────────────────────────────
PORT=3000
# Sessions last this many days
SESSION_TTL_DAYS=30
# Cookies get the Secure flag automatically on HTTPS. Force with true/false if needed.
# COOKIE_SECURE=true

# GEMINI_API_KEY: only needed if AI features are added later.
GEMINI_API_KEY="your_gemini_api_key_here"
APP_URL="http://localhost:3000"
