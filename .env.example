# ─── Database ──────────────────────────────────────────────────────────────
# PostgreSQL connection string. Tables are created/updated automatically on start.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/content_management

# Supabase instead (same line works on your PC and on the server):
#   Supabase → Connect → "Session pooler" → copy the URI and put your DB password in it, e.g.
# DATABASE_URL=postgresql://postgres.YOURPROJECTREF:YOUR_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# SSL is switched on automatically for any non-localhost database. Optional extras:
# DATABASE_SSL=auto            # auto | true | false
# DATABASE_SSL_CA=./data/supabase-ca.crt   # Supabase → Database settings → SSL → Download certificate
# DB_POOL_MAX=5                # keep low on Supabase (PC + server share the connection limit)

# Moving to a NEW, EMPTY database? Put the link of the database you used before here.
# On the first start the app copies EVERYTHING from it (accounts with their current
# passwords, content, activity, settings). You can remove the line afterwards.
# PREVIOUS_DATABASE_URL=postgresql://postgres:your_password@localhost:5432/content_management

# ─── Authentication & Seeding ──────────────────────────────────────────────
# Starting password for team members seeded from server/team.ts (never overwrites an existing password)
TEAM_DEFAULT_PASSWORD=your_team_default_password_here

# ─── Task e-mails ──────────────────────────────────────────────────────────
# People get an e-mail when they are assigned a task, asked for a revision, or a file
# is ready for them to post. Leave SMTP_HOST empty to switch e-mails off.
# Gmail: turn on 2-Step Verification, then create an App Password (myaccount.google.com/apppasswords)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourcompany@gmail.com
# SMTP_PASS=your16charapppassword
# MAIL_FROM="Quickupp ContentOps <yourcompany@gmail.com>"
# Hostinger Email instead: SMTP_HOST=smtp.hostinger.com  SMTP_PORT=465

# ─── Password vault (lets Admins see users' current passwords) ────────────
# Use the SAME key on your PC and on the server: copy the 64 characters from data/.vault-key.
# PASSWORD_VAULT_KEY=
# Keys used before (comma-separated) — passwords saved with them can still be shown:
# PASSWORD_VAULT_OLD_KEYS=

# ─── Files the app creates while running ──────────────────────────────────
# Default: ./data (password key, accounts backup) and ./uploads (designs & videos).
# On Hostinger Node.js hosting set these OUTSIDE public_html so deployments never
# delete them or fail while syncing, e.g.:
# DATA_DIR=/home/u123456789/domains/legalclaimscouncel.us/contentops-data
# UPLOADS_DIR=/home/u123456789/domains/legalclaimscouncel.us/contentops-uploads

# ─── Server ────────────────────────────────────────────────────────────────
PORT=3000
# Sessions last this many days
SESSION_TTL_DAYS=30
# Cookies get the Secure flag automatically on HTTPS. Force with true/false if needed.
# COOKIE_SECURE=true

# GEMINI_API_KEY: only needed if AI features are added later.
GEMINI_API_KEY="your_gemini_api_key_here"
APP_URL="https://legalclaimscouncel.us"
