# ─── Database ──────────────────────────────────────────────────────────────
# PostgreSQL connection string. Tables are created/updated automatically on start.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/contentflow

# ─── Google sign-in ("Continue with Google") ──────────────────────────────
# OAuth 2.0 Client ID (type: Web application) from Google Cloud Console →
# APIs & Services → Credentials. Add your site address (e.g. http://localhost:3000
# and your live domain) under "Authorized JavaScript origins".
# Only team members listed on the Team page can sign in with Google.
GOOGLE_CLIENT_ID=

# ─── Super Admin (email + password sign-in) ───────────────────────────────
# Created on first start. Change the password after your first sign-in
# (Team page → edit yourself), or set SUPER_ADMIN_RESET_PASSWORD=true for one
# restart to force the password below.
SUPER_ADMIN_EMAIL=admin@cf.com
SUPER_ADMIN_PASSWORD=Admin@123
SUPER_ADMIN_NAME=Super Admin
# SUPER_ADMIN_RESET_PASSWORD=true

# ─── Server ────────────────────────────────────────────────────────────────
PORT=3000
# Sessions last this many days
SESSION_TTL_DAYS=30
# Cookies get the Secure flag automatically on HTTPS. Force with true/false if needed.
# COOKIE_SECURE=true

# GEMINI_API_KEY: only needed if AI features are added later.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
